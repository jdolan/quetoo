{
  "identifier": "Response & service",
  "classNames": [
    "responseService"
  ],
  "subviews": [
    {
      "class": "StackView",
      "classNames": [
        "container"
      ],
      "subviews": [
        {
          "class": "StackView",
          "classNames": [
            "columns",
            "container"
          ],
          "subviews": [
            {
              "class": "StackView",
              "classNames": [
                "column",
                "container"
              ],
              "subviews": [
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Mouse"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Sensitivity"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "min": 0.125,
                          "max": 6,
                          "var": "mSensitivity"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Invert mouse"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "mInvert"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Smooth mouse"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "mInterpolate"
                        }
                      }
                    ]
                  }
                },
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Zoom"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Zoom"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "+ZOOM"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Zoom FOV"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "min": 30,
                          "max": 80,
                          "step": 1,
                          "var": "cg_fovZoom"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Zoom speed"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "min": 0,
                          "max": 2,
                          "step": 0.1,
                          "var": "cg_fovInterpolate"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Zoom sensitivity"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "min": 0.125,
                          "max": 6,
                          "var": "mSensitivityZoom"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "class": "StackView",
              "classNames": [
                "column",
                "container"
              ],
              "subviews": [
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Crosshair"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Crosshair"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "crosshairSelect",
                          "var": "cg_drawCrosshair"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Color"
                          }
                        },
                        "control": {
                          "class": "HueColorPicker",
                          "identifier": "crosshairColor"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Alpha"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "identifier": "crosshairAlpha",
                          "min": 0.1,
                          "max": 1,
                          "step": 0.05,
                          "var": "cg_drawCrosshairAlpha"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Scale"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "identifier": "crosshairScale",
                          "min": 0.1,
                          "max": 3,
                          "step": 0.05,
                          "var": "cg_drawCrosshairScale"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Pulse on pickup"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "min": 0,
                          "max": 1,
                          "step": 0.1,
                          "var": "cg_drawCrosshairPulse"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Color by health"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "crosshairHealth",
                          "var": "cg_drawCrosshairHealth"
                        }
                      }
                    ]
                  }
                },
                {
                  "class": "CrosshairPreviewView",
                  "identifier": "crosshairView"
                }
              ]
            },
            {
              "class": "StackView",
              "classNames": [
                "column",
                "container"
              ],
              "subviews": [
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "HUD"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "HUD"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "hudSelect",
                          "var": "cg_hud",
                          "expectsStringValue": true
                        }
                      }
                    ]
                  }
                },
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Communication"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Chat"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "cg_messageMode"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Team chat"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "cg_messageMode2"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Show score"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "+score"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Take screenshot"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "r_screenshot"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Take screenshot (3D only)"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "r_screenshot view"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
