  <!-- Capture the flag, for modules that opt in by setting QuetooCgameCtf and
       defining G_CTF; the counterpart of listing cg_ctf.c in a module's
       _SOURCES and adding -DG_CTF to its AM_CPPFLAGS. -->
  <ItemGroup Condition="'$(QuetooCgameCtf)'=='true'">
    <ClCompile Include="..\src\cgame\common\cg_ctf.c" />
    <ClInclude Include="..\src\cgame\common\cg_ctf.h" />
  </ItemGroup>
  <!-- The tech powerups, on the same terms: QuetooCgameTech and G_TECH. -->
  <ItemGroup Condition="'$(QuetooCgameTech)'=='true'">
    <ClCompile Include="..\src\cgame\common\cg_tech.c" />
    <ClInclude Include="..\src\cgame\common\cg_tech.h" />
  </ItemGroup>
  <!-- Windows has no separate discord-rpc project, so each cgame module
       compiles it in; autotools links deps/discord-rpc/libdiscord-rpc.la. -->
  <ItemGroup>
    <ClInclude Include="..\deps\discord-rpc\include\discord_register.h" />
    <ClInclude Include="..\deps\discord-rpc\include\discord_rpc.h" />
    <ClInclude Include="..\deps\discord-rpc\src\backoff.h" />
    <ClInclude Include="..\deps\discord-rpc\src\connection.h" />
    <ClCompile Include="..\deps\discord-rpc\src\connection_win.cpp" />
    <ClCompile Include="..\deps\discord-rpc\src\discord_register_win.cpp" />
    <ClCompile Include="..\deps\discord-rpc\src\discord_rpc.cpp" />
    <ClCompile Include="..\deps\discord-rpc\src\dllmain.cpp" />
    <ClInclude Include="..\deps\discord-rpc\src\msg_queue.h" />
    <ClCompile Include="..\deps\discord-rpc\src\rpc_connection.cpp" />
    <ClInclude Include="..\deps\discord-rpc\src\rpc_connection.h" />
    <ClCompile Include="..\deps\discord-rpc\src\serialization.cpp" />
    <ClInclude Include="..\deps\discord-rpc\src\serialization.h" />
  </ItemGroup>
</Project>
