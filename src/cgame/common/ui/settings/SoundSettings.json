{
  "identifier": "Sound",
  "classNames": [
    "settingsTab"
  ],
  "subviews": [
    {
      "class": "StackView",
      "classNames": [
        "container"
      ],
      "subviews": [
        {
          "class": "StackView",
          "classNames": [
            "columns",
            "container"
          ],
          "subviews": [
            {
              "class": "StackView",
              "classNames": [
                "column",
                "container"
              ],
              "subviews": [
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Playback"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Playback device"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "playbackDevice",
                          "var": "s_playbackDevice",
                          "expectsStringValue": true
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Enhanced effects"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "s_effects"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "HRTF (headphones)"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "s_hrtf"
                        }
                      }
                    ]
                  }
                },
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Volume"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Master"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_volume",
                          "min": 0,
                          "max": 1
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Effects"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_effectsVolume",
                          "min": 0,
                          "max": 1
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Ambient"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_ambientVolume",
                          "min": 0,
                          "max": 1
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Music"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_musicVolume",
                          "min": 0,
                          "max": 1
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Voice"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_voiceVolume",
                          "min": 0,
                          "max": 1
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "class": "StackView",
              "classNames": [
                "column",
                "container"
              ],
              "subviews": [
                {
                  "class": "Box",
                  "label": {
                    "text": {
                      "text": "Capture"
                    }
                  },
                  "contentView": {
                    "subviews": [
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Capture device"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "captureDevice",
                          "var": "s_captureDevice",
                          "expectsStringValue": true
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Microphone level"
                          }
                        },
                        "control": {
                          "class": "CaptureLevelView",
                          "identifier": "captureLevel"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Voice chat"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "s_voice"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Voice mode"
                          }
                        },
                        "control": {
                          "class": "CvarSelect",
                          "identifier": "voiceMode",
                          "var": "s_voiceMode"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Activation level"
                          }
                        },
                        "control": {
                          "class": "Slider",
                          "identifier": "voiceThreshold",
                          "min": 0.0,
                          "max": 0.1,
                          "step": 0.01,
                          "labelFormat": "%.2f"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Push to talk"
                          }
                        },
                        "control": {
                          "class": "BindTextView",
                          "bind": "+voice"
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Microphone gain"
                          }
                        },
                        "control": {
                          "class": "CvarSlider",
                          "var": "s_captureGain",
                          "min": 0,
                          "max": 2,
                          "step": 0.1
                        }
                      },
                      {
                        "class": "Input",
                        "label": {
                          "text": {
                            "text": "Auto-level"
                          }
                        },
                        "control": {
                          "class": "CvarCheckbox",
                          "var": "s_captureNormalize"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
