#!/bin/bash
# Wrapper called by quetoo-dedicated@.service.
# Parses /etc/quetoo-dedicated/<instance>.cfg and passes each non-blank,
# non-comment line as a +command argument to quetoo-dedicated.

INSTANCE="${1:?usage: quetoo-dedicated-start <instance>}"
CFG="/etc/quetoo-dedicated/${INSTANCE}.cfg"
BINARY="/usr/lib/quetoo/bin/quetoo-dedicated"

if [[ ! -f "$CFG" ]]; then
  echo "error: $CFG not found" >&2
  exit 1
fi

OPTS=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%//*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  eval "OPTS+=(+${line})"
done < "$CFG"

# Each instance has its own log, and its own crash log beside it (<instance>-crash.log). Each start
# truncates the log, and systemd restarts a crashed server within seconds, so keep the logs of
# previous runs.
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/WickedOldGames/Quetoo/logs/${INSTANCE}.log"
if [[ -f "$LOG" ]]; then
  for i in 9 8 7 6 5 4 3 2 1; do
    [[ -f "$LOG.$i" ]] && mv -f "$LOG.$i" "$LOG.$((i + 1))"
  done
  mv -f "$LOG" "$LOG.1"
fi

exec "$BINARY" -l "$LOG" "${OPTS[@]}"
