<?xml version="1.0" encoding="utf-8"?>
<!--
  The common client game sources, including the whole user interface, shared
  by every cgame module's project.

  They are compiled by each module rather than linked from one prebuilt
  library, because cg_state_t embeds the team roster, gameplay and item types
  from the module's own game directory: a shared copy would read cg_state at
  the wrong offsets in any module that changes its teams or item set.

  This list is the MSBuild counterpart of the _SOURCES lists in each module's
  src/cgame/*/Makefile.am, which the autotools build resolves through vpath.
  Both MUST be updated together when a common source is added or removed.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Include="..\src\cgame\common\cg_client.c" />
    <ClInclude Include="..\src\cgame\common\cg_client.h" />
