  <PropertyGroup Label="Globals">
    <ProjectGuid>{9d657586-69f6-54fd-9a93-118a9fdcd4de}</ProjectGuid>
    <RootNamespace>game-ctf</RootNamespace>
  </PropertyGroup>
  <!-- Selects the grapple sources from game_common.props. -->
  <PropertyGroup>
    <QuetooGameHook>true</QuetooGameHook>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="build_settings.props" />
    <Import Project="game_common.props" />
  </ImportGroup>
  <PropertyGroup>
    <!-- The engine loads this module as "game", so the module keeps that name
         and takes a directory of its own; Xcode does the same with
         PRODUCT_NAME and CONFIGURATION_BUILD_DIR. -->
    <TargetName>game</TargetName>
    <OutDir>$(QuetooOutDir)ctf\</OutDir>
    <IntDir>$(QuetooIntDir)</IntDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <IncludePath>$(QuetooFullIncludePath);$(IncludePath)</IncludePath>
    <LibraryPath>$(QuetooFullLibraryPath);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- This module's own directory comes first, then the common one. These
           are per project rather than in QuetooFullIncludePath because every
           module has a g_types.h: one global list would make it ambiguous. -->
      <AdditionalIncludeDirectories>..\src\game\ctf;..\src\game\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- G_HOOK and G_CTF switch on the grapple and capture play in the
           common sources. Set here rather than through
           $(ExtraPreprocessorDefinitions), which expands empty by the time
           build_settings.props' item definition is evaluated. -->
      <PreprocessorDefinitions>G_HOOK;G_CTF;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Objectively.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>game.def</ModuleDefinitionFile>
    </Link>
    <PostBuildEvent>
      <Command>COPY_GAME_CTF "$(QUETOO_HOME)" "$(Platform)$(Configuration)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="libs\libitemctf.vcxproj">
      <Project>{7d1ceb4a-3626-538b-9558-165e872d38d4}</Project>
    </ProjectReference>
