<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <None Include="game.def" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\src\game\game.h" />
    <ClInclude Include="..\src\game\race\bg_item.h" />
    <ClInclude Include="..\src\game\race\g_race.h" />
    <ClInclude Include="..\src\game\race\g_types.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\src\game\race\bg_item.c" />
    <ClCompile Include="..\src\game\race\g_module.c" />
    <ClCompile Include="..\src\game\race\g_race.c" />
    <ClCompile Include="..\src\game\race\g_race_entity.c" />
    <ClCompile Include="..\src\game\race\g_race_records.c" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{3c9e5fb2-6d74-4a1b-9153-8e4f7cab9d23}</ProjectGuid>
    <RootNamespace>game-race</RootNamespace>
  </PropertyGroup>
  <!-- Selects the grapple sources from game_common.props. -->
  <PropertyGroup>
    <QuetooGameHook>true</QuetooGameHook>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="build_settings.props" />
    <Import Project="game_common.props" />
  </ImportGroup>
  <PropertyGroup>
    <!-- The engine loads this module as "game", so the module keeps that name
         and takes a directory of its own; Xcode does the same with
         PRODUCT_NAME and CONFIGURATION_BUILD_DIR. -->
    <TargetName>game</TargetName>
    <OutDir>$(QuetooOutDir)race\</OutDir>
    <IntDir>$(QuetooIntDir)</IntDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <IncludePath>$(QuetooFullIncludePath);$(IncludePath)</IncludePath>
    <LibraryPath>$(QuetooFullLibraryPath);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- This module's own directory comes first, then the common one. These
           are per project rather than in QuetooFullIncludePath because every
           module has a g_types.h: one global list would make it ambiguous. -->
      <AdditionalIncludeDirectories>..\src\game\race;..\src\game\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- g_client_s and g_entity_s embed the server's view of themselves as an
           anonymous member, which needs this. clang-cl enables it by default; it
           is spelled out so that a toolset change cannot take it away quietly. -->
      <AdditionalOptions>%(AdditionalOptions) -fms-extensions -Wno-microsoft-anon-tag -ffp-contract=off</AdditionalOptions>
      <!-- These switch the optional features on in the common sources. Set
           here rather than through
           $(ExtraPreprocessorDefinitions), which expands empty by the time
           build_settings.props' item definition is evaluated. -->
      <PreprocessorDefinitions>G_HOOK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Objectively.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>game.def</ModuleDefinitionFile>
    </Link>
    <PostBuildEvent>
      <Command>COPY_GAME_MODULE "$(QUETOO_HOME)" "$(Platform)$(Configuration)" "race"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="libs\libshared.vcxproj">
      <Project>{2F1C792E-6243-462B-AF0D-E2554E77D5C5}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\Objectively\Objectively.vs15\Objectively.vcxproj">
      <Project>{3e6b97c6-1f51-4d72-bdfe-1d492f5eda6c}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
